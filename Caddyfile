trading.rbonilla.com {
    handle /api/* {
        reverse_proxy trading-api:8000
    }
    handle /auth/* {
        reverse_proxy trading-api:8000
    }
    handle {
        root * /srv/trading-frontend
        file_server
        try_files {path} /index.html
    }
}
api.trading.rbonilla.com {
    reverse_proxy trading-api:8000
}
yahoo.trading.rbonilla.com {
    reverse_proxy https://query2.finance.yahoo.com {
        header_up Host query2.finance.yahoo.com
        header_up User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        header_up Accept "application/json,*/*"
        header_up Accept-Language "es-ES,es;q=0.9"
    }
}
binance.trading.rbonilla.com {
    reverse_proxy https://api.binance.com {
        header_up Host api.binance.com
    }
}
